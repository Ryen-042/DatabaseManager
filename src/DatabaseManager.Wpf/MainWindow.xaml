<Window x:Class="DatabaseManager.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:controls="clr-namespace:DatabaseManager.Wpf.Controls"
    xmlns:views="clr-namespace:DatabaseManager.Wpf.Views"
    xmlns:behaviors="clr-namespace:DatabaseManager.Wpf.Behaviors"
    xmlns:converters="clr-namespace:DatabaseManager.Wpf.Converters"
        mc:Ignorable="d"
        Title="Database Manager"
        Height="860"
        Width="1360"
        MinHeight="760"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <converters:DirtyIndicatorConverter x:Key="DirtyIndicatorConverter" />
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:AppMenu Grid.Row="0" CommandRegistry="{Binding CommandRegistry}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SchemaAssistantColumn" Width="260" />
                <ColumnDefinition x:Name="SchemaAssistantSplitterColumn" Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SchemaAssistantPanel"
                    Grid.Column="0"
                    MinWidth="220"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource PanelBrush}">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="SCHEMA ASSISTANT"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <TabControl x:Name="SchemaAssistantTabControl" Grid.Row="1" Margin="0,8,0,0" SelectedIndex="{Binding SchemaAssistant.SchemaAssistantTabIndex, Mode=TwoWay}">
                        <TabItem Header="Tables">
                            <views:TablesPanelView DataContext="{Binding SchemaAssistant}" />
                        </TabItem>

                        <TabItem Header="Procedures">
                            <views:ProceduresPanelView DataContext="{Binding SchemaAssistant}" />
                        </TabItem>

                        <TabItem Header="Templates">
                            <views:TemplatesPanelView DataContext="{Binding TemplatesPanel}" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter x:Name="SchemaPanelSplitter"
                          Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent" />

            <Grid Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TabControl x:Name="OutputTabControl" Grid.Row="0">
                        <TabItem Header="Edit Rows">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                                    <Button x:Name="EnterEditModeButton"
                                            Content="Edit Top Rows"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="EnterEditModeButton_Click" />
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Top" />
                                    <TextBox x:Name="EditTopRowsTextBox"
                                             Width="70"
                                             Margin="0,0,8,0"
                                             VerticalContentAlignment="Center"
                                             Text="200"
                                             TextChanged="EditRowsInput_TextChanged" />
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Filter" />
                                    <TextBox x:Name="EditFilterTextBox"
                                             Width="260"
                                             Margin="0,0,8,0"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Optional SQL filter predicate, e.g. Age &gt; 30 AND Country = 'USA'"
                                             TextChanged="EditRowsInput_TextChanged" />
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Order By" />
                                    <TextBox x:Name="EditOrderByTextBox"
                                             Width="220"
                                             Margin="0,0,8,0"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Optional ORDER BY expression, e.g. Age DESC, Name ASC"
                                             TextChanged="EditRowsInput_TextChanged" />
                                    <Button x:Name="ApplyEditFilterButton"
                                            Content="Load"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ApplyEditFilterButton_Click" />
                                    <Button x:Name="SaveRowChangesButton"
                                            Content="Save Changes"
                                            Margin="0,0,8,0"
                                            IsEnabled="False"
                                            Click="SaveRowChangesButton_Click" />
                                    <Button x:Name="DiscardRowChangesButton"
                                            Content="Discard Changes"
                                            IsEnabled="False"
                                            Style="{StaticResource DestructiveButtonStyle}"
                                            Click="DiscardRowChangesButton_Click" />
                                </WrapPanel>

                                <CheckBox x:Name="EditRowsCustomQueryModeCheckBox"
                                          Grid.Row="1"
                                          Margin="0,10,0,0"
                                          Content="Custom SQL query mode"
                                          VerticalAlignment="Center"
                                          IsChecked="False"
                                          Checked="EditRowsCustomQueryModeCheckBox_Checked"
                                          Unchecked="EditRowsCustomQueryModeCheckBox_Unchecked" />

                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               FontWeight="SemiBold"
                                               Text="Generated Query (editable)" />

                                    <avalonEdit:TextEditor x:Name="EditQueryTextBox"
                                                           Grid.Row="1"
                                                           Margin="0,6,0,0"
                                                           MinHeight="70"
                                                           FlowDirection="LeftToRight"
                                                           Background="{DynamicResource InputBackgroundBrush}"
                                                           Foreground="{DynamicResource InputForegroundBrush}"
                                                           ShowLineNumbers="True"
                                                           VerticalScrollBarVisibility="Auto"
                                                           HorizontalScrollBarVisibility="Auto"
                                                           TextChanged="EditQueryTextBox_TextChanged"
                                                           PreviewKeyDown="SqlEditorTextBox_PreviewKeyDown"
                                                           FontFamily="Consolas"
                                                           FontSize="12" />
                                </Grid>

                                <GridSplitter Grid.Row="3"
                                              Height="6"
                                              Margin="0,6,0,0"
                                              HorizontalAlignment="Stretch"
                                              ResizeDirection="Rows"
                                              ResizeBehavior="PreviousAndNext"
                                              Background="Transparent" />

                                <TextBlock x:Name="EditRowsSummaryTextBlock"
                                           Grid.Row="4"
                                           Margin="0,10,0,0"
                                           FontWeight="SemiBold"
                                           Text="Edit mode is not active." />

                                <DataGrid x:Name="EditRowsDataGrid"
                                          Grid.Row="4"
                                          Margin="0,10,0,0"
                                          FlowDirection="LeftToRight"
                                          IsReadOnly="True"
                                          AutoGenerateColumns="True"
                                          AutoGeneratingColumn="ResultsDataGrid_AutoGeneratingColumn"
                                          HeadersVisibility="All"
                                          SelectionUnit="CellOrRowHeader"
                                          CanUserAddRows="True"
                                          CanUserDeleteRows="False"
                                          behaviors:DataGridBehaviors.ResetHorizontalScrollOnLoad="True"
                                          LoadingRow="EditRowsDataGrid_LoadingRow"
                                          CurrentCellChanged="EditRowsDataGrid_CurrentCellChanged"
                                          CellEditEnding="EditRowsDataGrid_CellEditEnding"
                                          PreviewMouseRightButtonDown="ResultsDataGrid_PreviewMouseRightButtonDown"
                                          PreviewMouseLeftButtonDown="EditRowsDataGrid_PreviewMouseLeftButtonDown"
                                          PreviewMouseLeftButtonUp="SchemaDataGrid_PreviewMouseLeftButtonUp"
                                          PreviewKeyDown="EditRowsDataGrid_PreviewKeyDown">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="DeleteRowMenuItem"
                                                      Header="Delete Row..."
                                                      IsEnabled="False"
                                                      Click="DeleteRowMenuItem_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Query">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Query document tab strip -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="New Query (Ctrl+T)"
                                            Command="{Binding QueryDocuments.NewDocumentCommand}">
                                        <Path Data="{StaticResource Icon.Plus}"
                                              Width="12"
                                              Height="12"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <ListBox x:Name="QueryDocumentsListBox"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ItemsSource="{Binding QueryDocuments.Documents}"
                                             SelectedItem="{Binding QueryDocuments.SelectedDocument, Mode=TwoWay}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="10,6" />
                                                <Setter Property="Margin" Value="0,0,2,0" />
                                                <Setter Property="BorderThickness" Value="0,0,0,2" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Padding="{TemplateBinding Padding}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    Background="{TemplateBinding Background}">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Margin="0,0,6,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{DynamicResource AccentBrush}"
                                                             Visibility="{Binding IsDirty, Converter={StaticResource DirtyIndicatorConverter}}" />
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                                    <Button Margin="8,0,0,0"
                                                            Width="16"
                                                            Height="16"
                                                            Padding="0"
                                                            ToolTip="Close (Ctrl+W)"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Command="{Binding DataContext.QueryDocuments.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource Icon.Close}"
                                                              Width="8"
                                                              Height="8"
                                                              Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.5" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>

                                <avalonEdit:TextEditor x:Name="QueryTextBox"
                                                       Grid.Row="1"
                                                       Padding="10"
                                                       FlowDirection="LeftToRight"
                                                       Background="{DynamicResource InputBackgroundBrush}"
                                                       Foreground="{DynamicResource InputForegroundBrush}"
                                                       ShowLineNumbers="True"
                                                       VerticalScrollBarVisibility="Auto"
                                                       HorizontalScrollBarVisibility="Auto"
                                                       TextChanged="SqlEditorTextBox_TextChanged"
                                                       PreviewKeyDown="SqlEditorTextBox_PreviewKeyDown"
                                                       FontFamily="Consolas"
                                                       FontSize="13" />

                                <GridSplitter Grid.Row="2"
                                              Height="6"
                                              HorizontalAlignment="Stretch"
                                              ResizeDirection="Rows"
                                              ResizeBehavior="PreviousAndNext"
                                              Background="Transparent" />

                                <Grid Grid.Row="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ResultsSummaryTextBlock" VerticalAlignment="Center" FontWeight="SemiBold" Text="Results" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,8,0"
                                                Content="Export CSV"
                                                MinWidth="90"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="ExportCsvButton_Click" />
                                        <Button Grid.Column="2"
                                                Content="Export Excel"
                                                MinWidth="95"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="ExportExcelButton_Click" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="1"
                                                  Margin="0,10,0,0"
                                                  FlowDirection="LeftToRight"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="ResultsSectionsPanel"
                                                    FlowDirection="LeftToRight" />
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Schema">
                            <views:SchemaDetailView DataContext="{Binding SchemaAssistant}" />
                        </TabItem>

                        <TabItem Header="Procedure Runner">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding ProcedureRunner.ProcedureSummary}" />

                                <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                                    <Button Content="Execute Procedure"
                                            Margin="0,0,8,8"
                                            Command="{Binding ProcedureRunner.ExecuteCommand}" />
                                </WrapPanel>

                                <DataGrid Grid.Row="2"
                                          FlowDirection="LeftToRight"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="All"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          ItemsSource="{Binding ProcedureRunner.Parameters}"
                                          behaviors:DataGridBehaviors.ResetHorizontalScrollOnLoad="True"
                                          PreviewMouseLeftButtonUp="SchemaDataGrid_PreviewMouseLeftButtonUp">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Parameter"
                                                            Binding="{Binding ParameterName}"
                                                            Width="180"
                                                            IsReadOnly="True" />
                                        <DataGridTextColumn Header="Data Type"
                                                            Binding="{Binding DataType}"
                                                            Width="130"
                                                            IsReadOnly="True" />
                                        <DataGridTextColumn Header="Value"
                                                            Width="*"
                                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridCheckBoxColumn Header="NULL"
                                                                Width="70"
                                                                Binding="{Binding SendAsNull}" />
                                        <DataGridCheckBoxColumn Header="Output"
                                                                Width="80"
                                                                Binding="{Binding IsOutput}"
                                                                IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Padding="14,6"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource PanelBrush}">
            <DockPanel LastChildFill="True">
                <!-- View toggles group (right-aligned) -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <CheckBox x:Name="SchemaPaneToggleButton"
                              Style="{StaticResource IconToggleButtonStyle}"
                              VerticalAlignment="Center"
                              Margin="0,0,4,0"
                              IsChecked="{Binding IsSchemaAssistantVisible, Mode=TwoWay}"
                              ToolTip="Show/hide Object Explorer">
                        <Path Data="{StaticResource Icon.Sidebar}"
                              Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round" />
                    </CheckBox>
                    <CheckBox x:Name="DarkModeCheckBox"
                              Style="{StaticResource IconToggleButtonStyle}"
                              VerticalAlignment="Center"
                              Margin="0,0,4,0"
                              IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                              ToolTip="Toggle dark/light theme">
                        <Grid>
                            <Path Data="{StaticResource Icon.Moon}"
                                  Width="15"
                                  Height="15"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=CheckBox}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="{StaticResource Icon.Sun}"
                                  Width="15"
                                  Height="15"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=CheckBox}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </CheckBox>
                    <CheckBox x:Name="FullOutputCheckBox"
                              Content="Full output"
                              VerticalAlignment="Center"
                              Padding="6,0,0,0"
                              ToolTip="When enabled, copy and export use non-truncated values." />
                </StackPanel>

                <!-- Primary actions group -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <Button x:Name="RunQueryButton"
                            Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding QueryDocument.RunCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Run}"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Run" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton"
                            Style="{StaticResource DestructiveButtonStyle}"
                            Command="{Binding QueryDocument.CancelCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Stop}"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Cancel" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Connection group (fills remaining space) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.Power}"
                          Width="15"
                          Height="15"
                          Stretch="Uniform"
                          Margin="0,0,8,0"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round" />
                    <!-- Actual value source for TryGetConnectionString() etc. - no longer the
                         visible control (see ConnectionSummaryButton below), so a saved
                         profile's decrypted string / a raw string typed in the picker's Raw
                         tab don't have to round-trip through a second control. Kept, not
                         removed, so every existing ConnectionStringTextBox.Text reference in
                         code-behind keeps working unchanged. -->
                    <TextBox x:Name="ConnectionStringTextBox" Visibility="Collapsed" />

                    <Button x:Name="ConnectionSummaryButton"
                            MinWidth="220"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="Choose a saved connection or enter one directly"
                            Click="ConnectionSummaryButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ConnectionSummaryTextBlock"
                                       Text="No connection set"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="220"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Path Data="{StaticResource Icon.ChevronDown}"
                                  Width="10"
                                  Height="10"
                                  Margin="8,0,0,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Timeout"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="TimeoutTextBox"
                             Width="56"
                             Margin="0,0,10,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Timeout in seconds"
                             Text="30" />
                    <Button x:Name="ConnectButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ConnectButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Power}"
                                  Width="13"
                                  Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeLineJoin="Round" />
                            <TextBlock Text="Connect" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="3"
                Padding="14,4"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource PanelBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="ConnectionStatusIndicator"
                         Grid.Column="0"
                         Width="7"
                         Height="7"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource TextSecondaryBrush}" />

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Ready." />

                <TextBlock x:Name="StatusDetailTextBlock"
                           Grid.Column="2"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Opacity="0.85" />

                <ProgressBar x:Name="StatusProgressBar"
                             Grid.Column="3"
                             Width="90"
                             Height="4"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
            </Grid>
        </Border>

        <Popup x:Name="SqlSuggestionPopup"
               Placement="Relative"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource SurfaceBrush}"
                    Padding="6"
                    MinWidth="280"
                    MaxWidth="520"
                    MaxHeight="280">
                <ListBox x:Name="SqlSuggestionListBox"
                         BorderThickness="0"
                         Background="Transparent"
                         MouseDoubleClick="SqlSuggestionListBox_MouseDoubleClick" />
            </Border>
        </Popup>

        <controls:ToastHost x:Name="ToastHostControl" Grid.Row="0" Grid.RowSpan="4" />
    </Grid>
</Window>
