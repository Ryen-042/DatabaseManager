<Window x:Class="DatabaseManager.Wpf.Windows.QueryParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Query Parameters"
        Width="620"
        Height="420"
        MinWidth="560"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   FontWeight="SemiBold"
                   Text="Enter values for SQL variables before execution." />

        <DataGrid x:Name="ParametersDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Variable" Binding="{Binding ParameterName}" IsReadOnly="True" Width="180" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridCheckBoxColumn Header="NULL" Binding="{Binding SendAsNull}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Cancel"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Execute"
                    MinWidth="90"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ExecuteButton_Click" />
        </StackPanel>
    </Grid>
</Window>
