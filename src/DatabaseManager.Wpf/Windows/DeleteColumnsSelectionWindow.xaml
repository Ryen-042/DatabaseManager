<Window x:Class="DatabaseManager.Wpf.Windows.DeleteColumnsSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Columns For Delete Filter"
        Width="620"
        Height="480"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   FontWeight="SemiBold"
                   Text="Select columns to build WHERE predicates for each selected row." />

        <DataGrid x:Name="ColumnsDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="All">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Use" Binding="{Binding IsSelected}" Width="70" />
                <DataGridTextColumn Header="Column" Binding="{Binding ColumnName}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}" IsReadOnly="True" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Cancel"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Apply"
                    MinWidth="90"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ApplyButton_Click" />
        </StackPanel>
    </Grid>
</Window>
