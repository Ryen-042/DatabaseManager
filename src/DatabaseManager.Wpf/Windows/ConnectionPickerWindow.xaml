<Window x:Class="DatabaseManager.Wpf.Windows.ConnectionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to Database"
        Width="680"
        Height="640"
        MinWidth="600"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- Connections: saved profiles list/edit form + a raw connection-string fallback, both always visible -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- List + management buttons -->
                <Grid x:Name="ListPanel" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="ProfilesListBox"
                             Grid.Row="0"
                             SelectionChanged="ProfilesListBox_SelectionChanged"
                             MouseDoubleClick="ProfilesListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                        <Border Margin="8,0,0,0"
                                                Padding="5,1"
                                                CornerRadius="3"
                                                Background="{DynamicResource AccentBrush}"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="DEFAULT" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Margin="0,2,8,0"
                                               Text="{Binding ConnectionStringPreview}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Margin="16,0,0,0"
                                               Text="{Binding LastUsedDisplay}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Button Content="New"
                                MinWidth="70"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="NewButton_Click" />
                        <Button x:Name="EditButton"
                                Content="Edit"
                                MinWidth="70"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="EditButton_Click" />
                        <Button x:Name="SetDefaultButton"
                                Content="Set Default"
                                MinWidth="90"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SetDefaultButton_Click" />
                        <Button x:Name="DeleteButton"
                                Content="Delete"
                                MinWidth="70"
                                IsEnabled="False"
                                Style="{StaticResource DestructiveButtonStyle}"
                                Click="DeleteButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- Add/edit form, toggled in place of the list -->
                <Grid x:Name="EditPanel" Grid.Row="0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Name" Margin="0,0,0,4" />
                    <TextBox x:Name="EditNameTextBox" Grid.Row="1" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="2" Text="Connection String" Margin="0,0,0,4" />
                    <TextBox x:Name="EditConnectionStringTextBox"
                             Grid.Row="3"
                             Margin="0,0,0,10"
                             AcceptsReturn="False"
                             TextWrapping="Wrap" />

                    <StackPanel Grid.Row="4" VerticalAlignment="Top">
                        <CheckBox x:Name="EditDefaultCheckBox" Content="Use as default connection" Margin="0,0,0,14" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save"
                                    MinWidth="80"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SaveProfileButton_Click" />
                            <Button Content="Cancel"
                                    MinWidth="80"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="CancelEditButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Raw connection-string fallback: always visible below the saved list, not a separate tab -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock TextWrapping="Wrap"
                               Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Or paste a connection string directly (not saved):" />
                    <TextBox x:Name="RawConnectionStringTextBox"
                             AcceptsReturn="False"
                             TextWrapping="Wrap"
                             TextChanged="RawConnectionStringTextBox_TextChanged" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="Transparent" />

            <!-- Databases: auto-fetched from whichever connection (saved or raw) is currently active -->
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBox x:Name="DatabaseSearchTextBox"
                             Width="180"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Filter databases"
                             TextChanged="DatabaseSearchTextBox_TextChanged" />
                    <CheckBox x:Name="ShowSystemDatabasesCheckBox"
                              Content="Show system databases"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Checked="ShowSystemDatabasesCheckBox_Changed"
                              Unchecked="ShowSystemDatabasesCheckBox_Changed" />
                    <Button x:Name="RefreshDatabasesButton"
                            Width="24"
                            Height="24"
                            Padding="0"
                            ToolTip="Refresh database list"
                            Style="{StaticResource IconButtonStyle}"
                            Click="RefreshDatabasesButton_Click">
                        <Path Data="{StaticResource Icon.Refresh}"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>

                <TextBlock x:Name="DatabaseStatusTextBlock"
                           Grid.Row="1"
                           Margin="0,0,0,6"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Select a saved connection or enter a connection string above to browse its databases."
                           Visibility="Visible" />

                <ListBox x:Name="DatabasesListBox"
                         Grid.Row="2"
                         SelectionChanged="DatabasesListBox_SelectionChanged" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Connect"
                    MinWidth="90"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ConnectButton_Click" />
        </StackPanel>
    </Grid>
</Window>
