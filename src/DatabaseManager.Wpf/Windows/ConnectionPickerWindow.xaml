<Window x:Class="DatabaseManager.Wpf.Windows.ConnectionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to Database"
        Width="640"
        Height="480"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="PickerTabControl" Grid.Row="0">
            <TabItem Header="Saved Connections">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- List + management buttons -->
                    <Grid x:Name="ListPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="ProfilesListBox"
                                 Grid.Row="0"
                                 SelectionChanged="ProfilesListBox_SelectionChanged"
                                 MouseDoubleClick="ProfilesListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                            <Border Margin="8,0,0,0"
                                                    Padding="5,1"
                                                    CornerRadius="3"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="DEFAULT" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Margin="16,0,0,0"
                                                   Text="{Binding LastUsedDisplay}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,10,0,0">
                            <Button Content="New"
                                    MinWidth="70"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="NewButton_Click" />
                            <Button x:Name="EditButton"
                                    Content="Edit"
                                    MinWidth="70"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="EditButton_Click" />
                            <Button x:Name="SetDefaultButton"
                                    Content="Set Default"
                                    MinWidth="90"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SetDefaultButton_Click" />
                            <Button x:Name="DeleteButton"
                                    Content="Delete"
                                    MinWidth="70"
                                    IsEnabled="False"
                                    Style="{StaticResource DestructiveButtonStyle}"
                                    Click="DeleteButton_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Add/edit form, toggled in place of the list -->
                    <Grid x:Name="EditPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Name" Margin="0,0,0,4" />
                        <TextBox x:Name="EditNameTextBox" Grid.Row="1" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="2" Text="Connection String" Margin="0,0,0,4" />
                        <TextBox x:Name="EditConnectionStringTextBox"
                                 Grid.Row="3"
                                 Margin="0,0,0,10"
                                 AcceptsReturn="False"
                                 TextWrapping="Wrap" />

                        <StackPanel Grid.Row="4" VerticalAlignment="Top">
                            <CheckBox x:Name="EditDefaultCheckBox" Content="Use as default connection" Margin="0,0,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save"
                                        MinWidth="80"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveProfileButton_Click" />
                                <Button Content="Cancel"
                                        MinWidth="80"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="CancelEditButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Raw Connection String">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Enter a connection string directly. This isn't saved anywhere - use &quot;Saved Connections&quot; to keep it for next time." />

                    <TextBox x:Name="RawConnectionStringTextBox"
                             Grid.Row="1"
                             AcceptsReturn="False"
                             TextWrapping="Wrap" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Connect"
                    MinWidth="90"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ConnectButton_Click" />
        </StackPanel>
    </Grid>
</Window>
